{
  "expo": {
    "name": "Aiyomi",
    "slug": "aiyomi",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "aiyomi",
    "userInterfaceStyle": "light",
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
