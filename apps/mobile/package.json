    "@react-native-community/datetimepicker": "9.1.0",
    "@supabase/supabase-js": "2.112.2",
    "expo": "~56.0.19",
    "expo-auth-session": "~56.0.16",
    "expo-constants": "~56.0.23",
    "expo-crypto": "~56.0.4",
