    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.1",
    "globals": "17.9.0",
    "turbo": "2.10.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0"
  }
}
